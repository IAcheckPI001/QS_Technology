
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Chỉ bật khi reverse proxy luôn ghi đè X-Request-ID
TRUST_PROXY_REQUEST_ID=false

# Visitor token cho khách website (HS256). Bắt buộc để dùng POST /chat/website.
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
VISITOR_TOKEN_SECRET=
VISITOR_TOKEN_TTL_SECONDS=604800
VISITOR_TOKEN_ISSUER=qs-chatbot

GPT4O_MINI_INPUT_USD_PER_MILLION=0.15
GPT4O_MINI_OUTPUT_USD_PER_MILLION=0.60
EMBEDDING_INPUT_USD_PER_MILLION=0.02
USD_TO_VND_RATE=26000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CONTEXT_TOKEN_BUDGET=800

# Chọn backend
LLM_PROVIDER=ollama


# Ollama local API
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
# Phải khớp `PARAMETER num_ctx` trong Modelfile; cửa sổ privacy phải nhỏ hơn num_ctx
OLLAMA_NUM_CTX=8192
OLLAMA_WINDOW_TOKENS=2500

# POST /ai/learning chưa có xác thực; chỉ bật khi kiểm thử nội bộ
LEARNING_API_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=