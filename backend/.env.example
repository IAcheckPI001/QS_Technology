OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CONTEXT_TOKEN_BUDGET=800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Ollama local API
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
# Phải khớp `PARAMETER num_ctx` trong Modelfile; cửa sổ privacy phải nhỏ hơn num_ctx
OLLAMA_NUM_CTX=8192
OLLAMA_WINDOW_TOKENS=2500

# POST /learning-knowledge chưa có xác thực; chỉ bật khi kiểm thử nội bộ
LEARNING_API_ENABLED=true

