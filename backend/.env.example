
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Chỉ bật khi reverse proxy luôn ghi đè X-Request-ID
TRUST_PROXY_REQUEST_ID=false

# Hệ thống tích hợp (website backend, CRM backend) gọi /chat/* bằng service key
# lưu trong DB (backend/sql/service_keys.sql); cấp bằng
# python -m app.modules.chatbot.service_keys_cli create ...

GPT4O_MINI_INPUT_USD_PER_MILLION=0.15
GPT4O_MINI_OUTPUT_USD_PER_MILLION=0.60
EMBEDDING_INPUT_USD_PER_MILLION=0.02
USD_TO_VND_RATE=26000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CONTEXT_TOKEN_BUDGET=800

# Kênh CRM: "agent" (tool-calling, thử nghiệm) hoặc "pipeline" (rollback về luồng tra cứu)
CRM_CHAT_FLOW=agent
# Giới hạn của một lượt agent; mọi timeout lấy từ deadline chung AGENT_TURN_TIMEOUT_S
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_TURN_TIMEOUT_S=60
AGENT_LLM_TIMEOUT_S=20
AGENT_TOOL_TIMEOUT_S=20
AGENT_FINAL_RESERVE_S=10
AGENT_TOOL_OUTPUT_TOKENS=3000
AGENT_PARALLEL_TOOLS=3
AGENT_MAX_CONCURRENT_RUNS=8
AGENT_HISTORY_MESSAGES=6
# Lease một lượt/phiên (409 session_busy); phải lớn hơn AGENT_TURN_TIMEOUT_S
CHAT_TURN_LEASE_S=120
# Trace từng lượt chat: luôn log dòng chat_trace; ghi public.chat_traces khi true
# (áp backend/sql/chat_traces.sql trước).
CHAT_TRACE_PERSIST=false
CHAT_TRACE_MAX_SPANS=500
# Tool báo cáo CRM (crm_report, thử nghiệm). Gọi API CRM với Bearer = user_id của /chat/crm
# (chỉ hợp lệ cho môi trường kiểm thử).
CRM_REPORT_ENABLED=false
CRM_API_BASE_URL=
CRM_API_TIMEOUT_S=10
CRM_REPORT_MAX_ITEMS=2000
CRM_REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# Chọn backend
LLM_PROVIDER=ollama


# Ollama local API
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
# Phải khớp `PARAMETER num_ctx` trong Modelfile; cửa sổ privacy phải nhỏ hơn num_ctx
OLLAMA_NUM_CTX=8192
OLLAMA_WINDOW_TOKENS=2500

# POST /ai/learning chưa có xác thực; chỉ bật khi kiểm thử nội bộ
LEARNING_API_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=