PORT=8787
# Dịch vụ AI (backend/), gọi server-to-server.
AI_SERVICE_URL=http://localhost:8000
# Service key kênh website, cấp bằng (chạy trong backend/):
# python -m app.modules.chatbot.service_keys_cli create --integration-id website_main --channel website
# Chỉ để ở server; không bao giờ đưa xuống trình duyệt.
CHATBOT_API_KEY=
# CHỈ ĐỂ KIỂM THỬ: service key kênh crm, bật route POST /api/chat/crm (user_id do
# trình duyệt gửi, nên ai gọi được route cũng mạo danh được nhân viên). Để trống ở production.
# python -m app.modules.chatbot.service_keys_cli create --integration-id crm_test --channel crm
CHATBOT_CRM_API_KEY=
# Origin được phép gọi POST /api/* (chống CSRF cho request xác thực bằng cookie).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true khi chạy HTTPS (production).
COOKIE_SECURE=false
# Thời gian chờ dịch vụ AI trả header (ms); không giới hạn thời lượng stream.
AI_RESPONSE_TIMEOUT_MS=30000
